# =============================================================================
# Moltiverse Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- LLM Provider ---
# Options: mock | openai | anthropic
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Data ---
DATA_DIR=./data
ENABLE_DECAY=true
DECAY_INTERVAL_HOURS=24

# --- DIVI Token (nad.fun) ---
# Set after running: npm run deploy-token
DIVI_TOKEN_ADDRESS=
MONAD_NETWORK=mainnet
PRIVATE_KEY=
NAD_API_KEY=
INITIAL_BUY_MON=0

# --- Token Monitor ---
ENABLE_TOKEN_MONITOR=true
TOKEN_POLL_INTERVAL_MS=60000

# --- Moltbook Agent Keys ---
# Set after running: npm run register-moltbook
ENABLE_MOLTBOOK=true
MOLTBOOK_PROPHET_KEY=
MOLTBOOK_THEOLOGIAN_KEY=
MOLTBOOK_MISSIONARY_KEY=
MOLTBOOK_ARCHIVIST_KEY=
MOLTBOOK_OBSERVER_KEY=

# --- MongoDB (Conversion Tracking) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=moltiverse
CONVERSION_POLL_MS=30000

# --- Autonomous Mode ---
ENABLE_AUTONOMOUS=true
